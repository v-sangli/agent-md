{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)"
    ],
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash",
      "WebSearch",
      "WebFetch(*)"
    ]
  }
}
